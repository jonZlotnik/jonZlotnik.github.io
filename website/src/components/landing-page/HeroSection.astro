---
import {
  CONTACT_LINKS,
  HOME_HERO_ASIDE,
  SITE_HERO,
  SITE_HERO_NAME,
} from "@/data/site";

const visibleContactLinks = CONTACT_LINKS.filter(
  (link) => link.visible !== false,
);
---

<section
  class="relative overflow-hidden bg-[var(--site-bg)] text-[var(--site-ink)] transition-colors duration-300"
>
  <button
    type="button"
    data-theme-quick-toggle
    class="fixed right-5 top-5 z-50 text-sm font-medium tracking-wide text-[var(--site-muted)] underline decoration-[color:var(--site-accent-soft)] underline-offset-4 transition hover:text-[var(--site-accent)] hover:decoration-[color:var(--site-accent)] md:right-8"
    aria-label="Toggle color theme"
  >
    Dark
  </button>
  <div class="absolute inset-x-0 top-0 h-px bg-[var(--site-rule)]"></div>
  <div class="absolute right-0 top-20 h-72 w-72 rounded-full bg-[var(--site-glow-warm)] blur-3xl"></div>
  <div class="absolute bottom-0 left-0 h-72 w-72 rounded-full bg-[var(--site-glow-cool)] blur-3xl"></div>

  <div class="relative mx-auto grid min-h-[calc(100svh-4rem)] max-w-6xl gap-12 px-5 py-16 md:grid-cols-[1.15fr_0.85fr] md:items-center md:px-8 lg:px-10">
    <div>
      <p class="mb-5 text-xs uppercase tracking-[0.34em] text-[var(--site-muted)]">
        {SITE_HERO.eyebrow}
      </p>

      <h1 class="max-w-3xl text-5xl font-medium tracking-[-0.055em] text-[var(--site-ink-strong)] sm:text-6xl md:text-7xl">
        {SITE_HERO_NAME}
      </h1>

      <p class="mt-6 max-w-2xl text-xl leading-8 text-[var(--site-body)] sm:text-2xl sm:leading-9">
        {SITE_HERO.intro}
      </p>

      <div class="mt-9 max-w-2xl border-y border-[var(--site-rule)] py-5">
        <p class="text-sm uppercase tracking-[0.26em] text-[var(--site-accent)]">
          {SITE_HERO.sayHelloHeading}
        </p>

        <nav aria-label="Contact links" class="mt-4 flex flex-wrap gap-x-5 gap-y-3">
          {
            visibleContactLinks.map((link) => (
              <a
                href={link.href}
                rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="group inline-flex items-center gap-1.5 text-base font-medium text-[var(--site-ink)] transition hover:text-[var(--site-accent)]"
              >
                <span class="underline decoration-[color:var(--site-accent-soft)] decoration-1 underline-offset-4 transition group-hover:decoration-[color:var(--site-accent)]">
                  {link.label}
                </span>
                <span aria-hidden="true" class="text-sm text-[var(--site-accent)] transition group-hover:translate-x-0.5">
                  →
                </span>
              </a>
            ))
          }
        </nav>
      </div>
    </div>

    <aside class="rounded-[2.5rem] border border-[var(--site-rule)] bg-[var(--site-surface)] p-4 shadow-[0_24px_80px_var(--site-shadow)] backdrop-blur">
      <div class="grid gap-3">
        <div class="aspect-[4/5] rounded-[2rem] bg-[linear-gradient(140deg,#3d4b4f,#c2a27f_52%,#eee4d5)] p-5 text-[#fffaf2]">
          <div class="flex h-full flex-col justify-between">
            <p class="max-w-48 text-sm leading-6 text-white/80">
              {HOME_HERO_ASIDE.panelSummary}
            </p>
            <div>
              <p class="text-xs uppercase tracking-[0.28em] text-white/70">
                {HOME_HERO_ASIDE.currentLabel}
              </p>
              <p class="mt-2 text-3xl font-medium tracking-[-0.04em]">
                {HOME_HERO_ASIDE.panelTitle}
              </p>
            </div>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div class="aspect-square rounded-[1.5rem] bg-[var(--site-tile-warm)]"></div>
          <div class="aspect-square rounded-[1.5rem] bg-[var(--site-tile-cool)]"></div>
        </div>
      </div>
    </aside>
  </div>
</section>
