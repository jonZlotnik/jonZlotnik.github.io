---
import { SITE_TITLE } from "@/consts";
import { CONTACT_LINKS, THEME } from "@/data/site";

const themeKey = THEME.storageKey;
const visibleContactLinks = CONTACT_LINKS.filter(
  (link) => link.visible !== false,
);
---

<footer
  class="border-t border-[var(--site-rule)] bg-[var(--site-bg)] text-[var(--site-body)] transition-colors duration-300"
>
  <div class="mx-auto max-w-7xl px-5 py-8 sm:px-6 lg:px-8">
    <div
      class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between"
    >
      <div class="space-y-1">
        <p class="text-sm text-[var(--site-ink)]">
          © {new Date().getFullYear()}
          {" "}{SITE_TITLE}
        </p>
        <nav
          aria-label="Footer contact"
          class="flex flex-wrap gap-x-4 gap-y-2 text-xs text-[var(--site-muted)]"
        >
          {
            visibleContactLinks.map((link) => (
              <a
                href={link.href}
                rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="underline decoration-[color:var(--site-accent-soft)] underline-offset-4 hover:text-[var(--site-accent)]"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <label class="flex items-center gap-2 text-[var(--site-muted)]">
          <span class="text-xs uppercase tracking-[0.2em]">{THEME.label}</span>
          <select
            data-theme-select
            class="rounded-full border border-[var(--site-rule)] bg-[var(--site-surface)] px-3 py-1.5 text-xs text-[var(--site-ink)] transition hover:border-[var(--site-accent)] focus:outline-none focus:ring-2 focus:ring-[var(--site-accent-soft)]"
            aria-label="Color theme preference"
          >
            <option value="system">System default</option>
            <option value="light">Light</option>
            <option value="dark">Dark</option>
          </select>
        </label>
      </div>
    </div>

    <div
      class="mt-6 flex flex-wrap items-center gap-3 border-t border-[var(--site-rule)] pt-6 text-sm"
    >
      <a href="/doodles" class="text-[var(--site-muted)] hover:text-[var(--site-accent)]">
        Updates
      </a>
      <span aria-hidden="true" class="text-[var(--site-rule)]">|</span>
      <a
        href="/rss.xml"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-[var(--site-muted)] hover:text-[var(--site-accent)]"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="opacity-85"
          aria-hidden="true"
        >
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
        <span>RSS</span>
      </a>
      <span aria-hidden="true" class="text-[var(--site-rule)]">|</span>
      <a href="/blogs" class="text-[var(--site-muted)] hover:text-[var(--site-accent)]">Writing</a>
    </div>
  </div>
</footer>

<script is:inline define:vars={{ themeKey }}>
  (function () {
    var KEY = themeKey;
    var initialized = false;

    function getStoredMode() {
      var pref =
        typeof localStorage !== "undefined" ? localStorage.getItem(KEY) : null;
      if (pref === "light" || pref === "dark") return pref;
      return "system";
    }

    function isDark(mode) {
      if (mode === "dark") return true;
      if (mode === "light") return false;
      try {
        return window.matchMedia("(prefers-color-scheme: dark)").matches;
      } catch (_) {
        return false;
      }
    }

    function syncQuickToggleLabel() {
      var btn = document.querySelector("[data-theme-quick-toggle]");
      if (!btn) return;
      var dark = document.documentElement.dataset.theme === "dark";
      btn.textContent = dark ? "Light" : "Dark";
    }

    function applyFromMode(mode) {
      document.documentElement.dataset.theme = isDark(mode) ? "dark" : "light";
      syncQuickToggleLabel();
    }

    function setMode(mode) {
      if (
        typeof localStorage !== "undefined" &&
        (mode === "light" || mode === "dark")
      ) {
        localStorage.setItem(KEY, mode);
      } else if (typeof localStorage !== "undefined") {
        localStorage.removeItem(KEY);
      }
      applyFromMode(mode === "system" ? "system" : mode);
      var sel = document.querySelector("[data-theme-select]");
      if (sel) sel.value = getStoredMode();
    }

    function init() {
      if (initialized) return;
      initialized = true;
      var mode = getStoredMode();
      applyFromMode(mode);
      var sel = document.querySelector("[data-theme-select]");
      if (sel) sel.value = mode;

      sel?.addEventListener("change", function () {
        setMode(sel.value);
      });

      var quick = document.querySelector("[data-theme-quick-toggle]");
      quick?.addEventListener("click", function () {
        var dark = document.documentElement.dataset.theme === "dark";
        setMode(dark ? "light" : "dark");
      });

      try {
        var mq = window.matchMedia("(prefers-color-scheme: dark)");
        mq.addEventListener("change", function () {
          if (getStoredMode() === "system") applyFromMode("system");
        });
      } catch (_) {}
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
