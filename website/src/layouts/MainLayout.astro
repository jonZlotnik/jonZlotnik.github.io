---
import { z } from "astro:content";
import { THEME } from "@/data/site";
import { cn } from "@/lib/utils";
import type { SlideMetadata } from "@/schemas/slide";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import { Toaster } from "../components/ui/sonner";

import "../styles/global.css";

const themeStorageKey = THEME.storageKey;

interface Props {
  title: string;
  description: string;
  image?: string;
  className?: string;
  keywords?: string;
  robots?: string;
  author?: string;
  type?: "website" | "article" | "product";
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  tags?: string[];
  revealTheme?: z.infer<typeof SlideMetadata>["theme"];
}

const {
  title,
  description,
  image,
  className,
  keywords,
  robots,
  author,
  type,
  publishedTime,
  modifiedTime,
  section,
  tags,
  revealTheme,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="site-root">
  <head>
    <!-- Theme before paint — matches footer control (THEME.storageKey). -->
    <script is:inline define:vars={{ themeStorageKey }}>
      (function () {
        var KEY = themeStorageKey;
        var pref =
          typeof localStorage !== "undefined" ? localStorage.getItem(KEY) : null;

        function isDark(mode) {
          if (mode === "dark") return true;
          if (mode === "light") return false;
          try {
            return window.matchMedia("(prefers-color-scheme: dark)").matches;
          } catch (_) {
            return false;
          }
        }

        var mode =
          pref === "light" || pref === "dark"
            ? pref
            : "system";
        document.documentElement.dataset.theme = isDark(mode) ? "dark" : "light";
      })();
    </script>
    <BaseHead
      title={title}
      description={description}
      image={image}
      keywords={keywords}
      robots={robots}
      author={author}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      section={section}
      tags={tags}
    />
    {
      revealTheme && (
        <link
          rel="stylesheet"
          href={`https://cdnjs.cloudflare.com/ajax/libs/reveal.js/5.2.1/theme/${revealTheme}.css`}
        />
      )
    }
  </head>
  <body>
    <div
      class={cn(
        "flex min-h-screen-stable flex-col bg-[var(--site-bg)] text-[var(--site-ink)] transition-colors duration-300",
      )}
    >
      <main class="flex-1">
        <div class={cn(className ? className : "container p-3 md:p-5 mx-auto")}>
          <slot />
        </div>
      </main>
      <Footer />
    </div>
    <Toaster client:load />
    <script is:inline type="module">
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";
      mermaid.initialize({ startOnLoad: true });
    </script>
  </body>
</html>

<style>
  .min-h-screen-stable {
    min-height: 100vh;
    min-height: 100svh;
  }
</style>
